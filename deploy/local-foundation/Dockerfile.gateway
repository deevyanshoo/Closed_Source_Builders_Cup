# Prepared packaging only. Build context is repository root.
FROM node:22-bookworm AS web
WORKDIR /src/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
COPY contracts/generated /src/contracts/generated
RUN npm run build

FROM golang:1.27-bookworm AS go
WORKDIR /src/services/gateway
COPY services/gateway/go.mod services/gateway/go.sum ./
RUN go mod download
COPY services/gateway/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/gateway .

FROM gcr.io/distroless/base-debian12:nonroot
WORKDIR /app
COPY --from=go /out/gateway /app/gateway
COPY --from=web /src/apps/web/dist /app/web
COPY contracts/examples /app/contracts/examples
ENV WEB_ASSETS_DIR=/app/web CONTRACT_EXAMPLES_DIR=/app/contracts/examples
EXPOSE 8080
ENTRYPOINT ["/app/gateway"]
