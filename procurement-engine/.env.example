# Copy to .env and fill in what you need. Every value is optional.

# Google Gemini key for headline extraction. Without it, keyword rules are used.
GEMINI_API_KEY=

# 1 = never call the network; use cached files, then synthetic prices and sample news.
OFFLINE=0

# Where the UI finds the API.
PROCURE_API_URL=http://localhost:8000

# Optional: company name used in the RFQ signature.
COMPANY_NAME=

# Optional overrides
# PROCURE_DATA_DIR=./data
# PROCURE_DB_PATH=./data/app.duckdb
# PROCURE_SEED=42
